---
import Base from '../layouts/Base.astro';
import data from '../data/results.json';
import glyphs from '../data/glyphs.json';
import { bar, pct, verdict, money, secs } from '../lib/fmt';

const { meta, leaderboard, overall, by_level, by_mode } = data as any;
const g = glyphs as any;
const order = Object.keys(g).map(Number).sort((a, b) => a - b);
const levelKeys = Object.keys(by_level).sort();
---

<Base
  title="leaderboard"
  path="/"
  lede="Every model, every metric, in one table. Sort any column, filter by name. Runs that left their working directory are shown but never scored."
>
  <!-- ---------- summary ---------- -->
  <section class="panel">
    <div class="summary">
      <span class={`badge big ${meta.complete ? 'pass' : 'info'}`}>
        {meta.complete ? '✓ COMPLETE' : '● RUNNING'}
      </span>
      <div class="summary-main">
        <div class="summary-date">{meta.generated}</div>
        <div class="metaline">
          {meta.machine} · {meta.video.res} · {meta.video.fps}fps · {meta.video.frames} frames ·
          {meta.video.glyphs} glyphs in {meta.video.typefaces} typefaces
        </div>
        <div class="badgerow">
          <span class="badge info">{meta.total_runs}/{meta.planned_runs} runs</span>
          <span class="badge mute">{meta.models} {meta.models === 1 ? 'model' : 'models'}</span>
          <span class={`badge ${meta.cheated > 0 ? 'fail' : 'pass'}`}>
            {meta.cheated > 0 ? `✗ ${meta.cheated} invalidated` : '✓ 0 invalidated'}
          </span>
          <span class="badge pass">✓ isolated workdirs</span>
          <span class="badge pass">✓ key committed in advance</span>
        </div>
      </div>
    </div>

    <!-- the target, each letter in the face it is actually drawn in -->
    <div class="wordstrip">
      {order.map((i) => (
        <div class="cell">
          <span
            class="glyph glyph-lg"
            style={`-webkit-mask-image:url(${g[i].data});mask-image:url(${g[i].data});width:${(54 * g[i].aspect).toFixed(1)}px`}
            role="img"
            aria-label={g[i].char}
          />
          <div class="face">{g[i].font}</div>
        </div>
      ))}
    </div>
  </section>

  {meta.total_runs === 0 && (
    <section class="panel">
      <p class="note">No runs recorded yet. This page rebuilds from <code>results/runs.jsonl</code>.</p>
    </section>
  )}

  {meta.total_runs > 0 && (
    <>
      <section class="panel">
        <div class="panel-head">
          <div>
            <div class="panel-title">overall</div>
            <div class="panel-sub">across every model, level and prompt mode</div>
          </div>
          <span class={`badge ${verdict(overall).cls}`}>{verdict(overall).text}</span>
        </div>
        <div class="tiles">
          <div class="tile"><div class="label">runs scored</div><div class="value">{overall.valid}</div></div>
          <div class="tile"><div class="label">exact solves</div><div class="value">{overall.exact}<span class="unit">/{overall.valid}</span></div></div>
          <div class="tile"><div class="label">mean chars</div><div class="value">{overall.chars}<span class="unit">/17</span></div></div>
          <div class="tile"><div class="label">mean frames</div><div class="value">{overall.frames}<span class="unit">/17</span></div></div>
          <div class="tile"><div class="label">mean spatial</div><div class="value">{overall.spatial}<span class="unit">/17</span></div></div>
          <div class="tile"><div class="label">mean time</div><div class="value">{Math.round(overall.wall_s)}<span class="unit">s</span></div></div>
          <div class="tile"><div class="label">invalidated</div><div class="value">{overall.cheated}</div></div>
        </div>
      </section>

      <section class="panel">
        <div class="panel-head">
          <div>
            <div class="panel-title">every metric</div>
            <div class="panel-sub">
              click any column to sort. word, temporal and spatial accuracy are
              kept separate — reading the word and knowing where you saw it are
              different abilities.
            </div>
          </div>
        </div>

        <div class="toolbar">
          <input class="search" data-search="lb" type="search" placeholder="filter models…" />
          <span class="count" data-count="lb"></span>
        </div>

        <div class="scroll" data-table="lb">
          <table>
            <thead>
              <tr>
                <th data-sort="str">model</th>
                <th class="num" data-sort="num">solved</th>
                <th class="num" data-sort="num">chars/17</th>
                <th>accuracy</th>
                <th class="num" data-sort="num">best</th>
                <th class="num" data-sort="num">frame</th>
                <th class="num" data-sort="num">spatial</th>
                <th class="num" data-sort="num">lev</th>
                {levelKeys.map((lv) => <th class="num" data-sort="num">L{lv}</th>)}
                <th class="num" data-sort="num">blind</th>
                <th class="num" data-sort="num">hinted</th>
                <th class="num" data-sort="num">avg t</th>
                <th class="num" data-sort="num">shell</th>
                <th class="num" data-sort="num">ffmpeg</th>
                <th class="num" data-sort="num">python</th>
                <th class="num" data-sort="num">imgs</th>
                <th class="num" data-sort="num">diffed</th>
                <th class="num" data-sort="num">out tok</th>
                <th class="num" data-sort="num">cost</th>
                <th class="num" data-sort="num">fail</th>
                <th class="num" data-sort="num">invalid</th>
              </tr>
            </thead>
            <tbody>
              {leaderboard.map((a: any) => {
                const b = bar(pct(a.chars, 17));
                return (
                  <tr>
                    <td class="model">{a.model}</td>
                    <td class="num" data-v={pct(a.exact, a.valid)}>{a.exact}/{a.valid}</td>
                    <td class="num">{a.chars}</td>
                    <td data-v={a.chars}>
                      <span class="bar"><span class={b.cls}>{b.on}</span><span class="off">{b.off}</span></span>
                    </td>
                    <td class="num">{a.best_chars}</td>
                    <td class="num">{a.frames}</td>
                    <td class="num">{a.spatial}</td>
                    <td class="num">{a.lev}</td>
                    {levelKeys.map((lv) => {
                      const c = by_level[lv][a.model];
                      return <td class="num">{c && c.valid ? c.chars : '—'}</td>;
                    })}
                    <td class="num">{by_mode.Blind[a.model]?.valid ? by_mode.Blind[a.model].chars : '—'}</td>
                    <td class="num">{by_mode.Hinted[a.model]?.valid ? by_mode.Hinted[a.model].chars : '—'}</td>
                    <td class="num">{secs(a.wall_s)}</td>
                    <td class="num">{a.shell}</td>
                    <td class="num">{a.ffmpeg}</td>
                    <td class="num">{a.python}</td>
                    <td class="num">{a.images}</td>
                    <td class="num">{a.diffed}</td>
                    <td class="num">{Math.round(a.out_tokens).toLocaleString()}</td>
                    <td class="num">{money(a.cost)}</td>
                    <td class="num">{a.failed}</td>
                    <td class="num">{a.cheated}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>

      <section class="panel">
        <div class="panel-head">
          <div>
            <div class="panel-title">what the hint is worth</div>
            <div class="panel-sub">
              blind says only that something is hidden. hinted gives the length,
              the one-typeface-per-letter rule, temporal ordering, and warns
              about faintness and decoys.
            </div>
          </div>
        </div>
        <div class="scroll">
          <table>
            <thead>
              <tr>
                <th>model</th>
                <th class="num">blind chars</th>
                <th class="num">hinted chars</th>
                <th class="num">Δ</th>
                <th class="num">blind solved</th>
                <th class="num">hinted solved</th>
              </tr>
            </thead>
            <tbody>
              {leaderboard.map((a: any) => {
                const bl = by_mode.Blind[a.model] || { chars: 0, exact: 0, valid: 0 };
                const hi = by_mode.Hinted[a.model] || { chars: 0, exact: 0, valid: 0 };
                // A delta against a mode with no runs is not a delta -- while
                // the grid is partway through, one side is often still empty.
                const comparable = bl.valid > 0 && hi.valid > 0;
                const d = +(hi.chars - bl.chars).toFixed(1);
                const cls = !comparable ? 'mute' : d > 0.5 ? 'pass' : d < -0.5 ? 'fail' : 'mute';
                return (
                  <tr>
                    <td class="model">{a.model}</td>
                    <td class="num">{bl.valid ? bl.chars : '—'}</td>
                    <td class="num">{hi.valid ? hi.chars : '—'}</td>
                    <td class="num">
                      <span class={`badge ${cls}`}>
                        {comparable ? (d > 0 ? `+${d}` : d) : 'n/a'}
                      </span>
                    </td>
                    <td class="num">{bl.valid ? `${bl.exact}/${bl.valid}` : '—'}</td>
                    <td class="num">{hi.valid ? `${hi.exact}/${hi.valid}` : '—'}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    </>
  )}
</Base>
